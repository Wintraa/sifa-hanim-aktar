{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix client install",
  "buildCommand": "node client/scripts/prepare-public.mjs && node client/scripts/generate-sitemap.mjs && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "build": {
    "env": {
      "SITE_URL": "https://sifahanimaktar.vercel.app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/((?!api/|assets/|brand/|data/|favicon\\.ico|favicon-48x48\\.png|apple-touch-icon\\.png|icon-512\\.png|site\\.webmanifest|sitemap\\.xml|robots\\.txt|google[^/]*\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
